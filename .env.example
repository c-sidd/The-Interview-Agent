# ==============================================================================
# AI Interview Agent — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the root directory and populate the variables.
# Never commit the actual '.env' file containing secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# NODE_ENV: Runtime environment mode (development, production, test)
NODE_ENV=development

# PORT: The port number the Express API server will listen on
PORT=3000

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration
# ------------------------------------------------------------------------------
# LLM_PROVIDER: Active LLM connector service (gemini, openai, anthropic, mock)
# Set to 'mock' to run the application offline without making external API queries.
LLM_PROVIDER=gemini

# TEMPERATURE: Controls randomness in prompt completions (0.0 = analytical, 1.0 = creative)
# Recommended range for technical interviews: 0.1 to 0.3 to maintain rubric consistency.
TEMPERATURE=0.2

# MAX_TOKENS: Maximum completion token limit for a single conversational response.
MAX_TOKENS=800

# ------------------------------------------------------------------------------
# 3. Google Gemini Settings (Primary Provider)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google AI Studio API key (Required if LLM_PROVIDER is 'gemini')
GEMINI_API_KEY=

# GEMINI_MODEL: Target model identifier (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Optional Future LLM Providers (Hold placeholders for Live Steer Challenge)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: OpenAI developer API key (Required if LLM_PROVIDER is 'openai')
OPENAI_API_KEY=

# OPENAI_MODEL: Target OpenAI model (e.g., gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY: Anthropic developer API key (Required if LLM_PROVIDER is 'anthropic')
ANTHROPIC_API_KEY=

# ANTHROPIC_MODEL: Target Anthropic model (e.g., claude-3-5-sonnet-latest)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# GROQ_API_KEY: Groq cloud developer API key (Optional alternative engine)
GROQ_API_KEY=

# GROQ_MODEL: Target model running on Groq (e.g., llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192

# ------------------------------------------------------------------------------
# 5. Session Security
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cryptographic secret key used to sign the cookie session IDs
# Change this to a long random string in production.
SESSION_SECRET=dev-session-key-change-me-in-production

# ------------------------------------------------------------------------------
# 6. Logging & Diagnostics
# ------------------------------------------------------------------------------
# LOG_LEVEL: Verbosity level for system logs (error, warn, info, debug)
# Recommended 'debug' during development, and 'info' or 'warn' in production.
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. Deployment Configuration
# ------------------------------------------------------------------------------
# BASE_URL: Public URL of the deployed application (used for CORS and redirect domains)
BASE_URL=http://localhost:3000
